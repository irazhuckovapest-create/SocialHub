@model SocialHub.Models.Post
@{
    ViewData["Title"] = Model.Title;
}

<div class="post-full">
    <h1 class="post-title">@Model.Title</h1>
    <p>
        <span class="post-author">@Model.Author</span>
        <span class="post-date"> · @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
    </p>
    <p class="post-text">@Model.Text</p>

    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">Редагувати</a>

        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Видалити пост?');">
            <button type="submit" class="btn btn-danger btn-sm">Видалити пост</button>
        </form>
    </div>
</div>

<h4 class="mb-3">Коментарі (@Model.Comments.Count)</h4>

@if (Model.Comments.Count == 0)
{
    <p class="text-muted">Коментарів поки немає.</p>
}

@foreach (var comment in Model.Comments)
{
    <div class="comment-box">
        <strong>@comment.Author</strong>
        <span class="post-date"> · @comment.CreatedAt.ToString("dd.MM.yyyy HH:mm")</span>
        <p class="mb-2 mt-1">@comment.Text</p>

        <form asp-controller="Comments" asp-action="Delete" asp-route-id="@comment.Id" method="post">
            <button type="submit" class="btn btn-outline-danger btn-sm">Видалити коментар</button>
        </form>
    </div>
}

<div class="form-box mt-4">
    <h5 class="mb-3">Додати коментар</h5>
    <form asp-controller="Comments" asp-action="Add" method="post">
        <input type="hidden" name="postId" value="@Model.Id" />

        <div class="mb-2">
            <input type="text" name="author" class="form-control" placeholder="Ваше ім'я" />
        </div>
        <div class="mb-2">
            <textarea name="text" class="form-control" rows="3" placeholder="Ваш коментар"></textarea>
        </div>
        <button type="submit" class="btn btn-main">Надіслати</button>
    </form>
</div>