@model List<SocialHub.Models.Post>
@{
    ViewData["Title"] = "Усі пости";
}

<h1 class="page-title">Усі пости</h1>

<form method="get" asp-controller="Posts" asp-action="Index" class="row g-2 mb-4">
    <div class="col-12 col-md-5">
        <input type="text" name="author" value="@ViewBag.Author" class="form-control" placeholder="Пошук за автором" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-main">Знайти</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Скинути</a>
    </div>
</form>

@if (Model.Count == 0)
{
    <p>Нічого не знайдено.</p>
}

@foreach (var post in Model)
{
    <partial name="_PostCard" model="post" />
}